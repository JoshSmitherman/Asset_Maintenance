# Copy this file to .env.local (local development) and fill in the values from
# Supabase -> Project Settings -> API.
#
# Both values are safe to expose in a browser bundle: the anon key only grants
# what your Row Level Security policies allow. NEVER put the service_role key here.

# Just the project URL. NOT the "Data API" URL the dashboard also shows, which
# ends in /rest/v1/ - that makes every request path wrong and sign-in fails
# with "Invalid path specified in request URL". The app trims it off anyway,
# but the setting should be right.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base path for the built app.
# - Local dev / custom domain / <user>.github.io root site:  /
# - GitHub Pages project site (https://<user>.github.io/<repo>/):  /<repo>/
# Leave this unset locally; the GitHub Actions workflow sets it automatically.
VITE_BASE_PATH=/
